{
  "name": "Singer",
  "slug": "singer",
  "identifier": "uk.ihack.singer",
  "version": "0.1.0",
  "icon": "cmd/singer/assets/icon.png",
  "main": "./cmd/singer",
  "out": "build",
  "linux": {
    "webview": false
  },
  "android": {
    "minSdk": 26,
    "splash": "#0F172A",
    "adaptiveIcon": {
      "foreground": "cmd/singer/assets/icon-foreground.png",
      "background": "#0F172A"
    },
    "permissions": [
      "ACCESS_NETWORK_STATE",
      "FOREGROUND_SERVICE",
      "FOREGROUND_SERVICE_SPECIAL_USE",
      "POST_NOTIFICATIONS"
    ]
  }
}
